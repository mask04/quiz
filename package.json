{
  "name": "quiz-api",
  "version": "1.0.0",
  "description": "A RESTful quiz API built with Node.js, Express, and MongoDB (Mongoose). Supports CRUD on questions, answer validation, scoring, leaderboards, timed quizzes, statistics, and result export.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/utils/seed.js"
  },
  "keywords": [
    "quiz",
    "api",
    "express",
    "mongodb",
    "mongoose",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
